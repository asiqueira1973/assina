# Variáveis da seção 18 do spec. Copie para .env.local e preencha. Nunca commite .env.local.
NEXT_PUBLIC_SITE_URL=http://localhost:3030
# Produção: https://assina.app.br

# Banco (Supabase compartilhado; local nas portas 555xx). A chave local sai de `supabase status`.
SUPABASE_URL=http://127.0.0.1:55521
SUPABASE_SERVICE_ROLE_KEY=

# Login (projeto Google Cloud "Assina"; README, seção Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Segredos próprios: openssl rand -base64 32
SESSION_SECRET=
CHAVES_ENC_KEY=
CRON_SECRET=

# Proteções (regra 11.12). Vazia = cadastro aberto.
EMAILS_PERMITIDOS=
EMAILS_BLOQUEADOS=
CONTAS_NOVAS_POR_DIA=50
ADMIN_EMAIL=

# Arquivos (Cloudflare R2; token restrito ao bucket) — a partir do épico 8.2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=assina-documentos

# E-mail (Resend) — a partir do épico 8.4. Em dev: onboarding@resend.dev
RESEND_API_KEY=
EMAIL_REMETENTE=onboarding@resend.dev

# Selo (épico 8.6): npm run selo:gerar para dev
SELO_P12_BASE64=
SELO_P12_SENHA=
# Opcional (B-T). Responderam em 17/11/2026: http://timestamp.digicert.com, https://freetsa.org/tsr, http://timestamp.sectigo.com
SELO_TSA_URL=

# Analytics (Visão do Produto, épico 8.11)
VISAO_INGEST_URL=
VISAO_API_KEY=
