{
  "name": "assina",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev --port 3030",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "start": "next start --port 3030",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test:guardrails": "./scripts/test-guardrails.sh",
    "test:db": "node scripts/test-db.mjs",
    "test:unit": "vitest run --passWithNoTests",
    "test": "npm run test:guardrails && npm run test:db && npm run test:unit",
    "audit": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run audit",
    "db:types": "node scripts/gen-db-types.mjs",
    "db:schema": "node scripts/gen-schema.mjs",
    "selo:gerar": "node scripts/selo-gerar.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/s3-request-presigner": "^3.1170.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@signpdf/placeholder-pdf-lib": "^4.0.0",
    "@signpdf/signpdf": "^4.0.0",
    "@signpdf/utils": "^4.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "jose": "^6.2.15",
    "lucide-react": "^1.67.0",
    "next": "16.4.6",
    "node-forge": "^1.4.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
